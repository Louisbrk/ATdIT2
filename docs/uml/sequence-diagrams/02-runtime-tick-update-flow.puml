@startuml
title Runtime Tick Update Flow

participant DefaultSimulationService
participant "SpaceFlightApp\nTickListener" as TickListener
participant FlightSimulationService
participant VitalSignsGenerator
participant Passenger
participant SimulationSnapshot
participant BaseStationView
participant AiHealthDashboardView
participant StewardessInboxView
participant PassengerDashboardView

loop every tick
  DefaultSimulationService -> TickListener : onTick(tickCount)
  TickListener -> FlightSimulationService : update(tickCount)
  FlightSimulationService --> TickListener : current shuttle state updated

  loop for each passenger
    TickListener -> VitalSignsGenerator : generateNext(passenger, phase)
    VitalSignsGenerator --> TickListener : VitalSigns
    TickListener -> Passenger : setVitalSigns(vitals)
  end

  TickListener -> SimulationSnapshot : new SimulationSnapshot(state, passengers,\nemergencyProgress, tickCount)
  SimulationSnapshot --> TickListener : snapshot

  TickListener -> BaseStationView : updateFlightInfo(live ShuttleState)
  TickListener -> BaseStationView : updatePassengerCards(live passengers)
  TickListener -> BaseStationView : updateDetailView()
  TickListener -> AiHealthDashboardView : update(live passengers, phase)

  alt stewardess window open
    TickListener -> StewardessInboxView : update(snapshot)
  end

  loop for each open passenger dashboard
    TickListener -> PassengerDashboardView : update(snapshot)
  end
end

note right of SimulationSnapshot
Passenger and stewardess views receive
the snapshot instead of direct live objects.
end note

@enduml
