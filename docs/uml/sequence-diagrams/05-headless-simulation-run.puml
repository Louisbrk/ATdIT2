@startuml
title Headless Simulation Run

participant HeadlessSimulationRunner
participant PassengerRegistry
participant DefaultFlightSimulationService
participant DefaultVitalSignsGenerator
participant KnnHealthEvaluationService
participant SimulationObserver
participant Passenger

HeadlessSimulationRunner -> PassengerRegistry : new PassengerRegistry()
HeadlessSimulationRunner -> PassengerRegistry : getAllPersons()
PassengerRegistry --> HeadlessSimulationRunner : passengers

HeadlessSimulationRunner -> DefaultVitalSignsGenerator : configure(500)
HeadlessSimulationRunner -> DefaultVitalSignsGenerator : markAsEmergency(name, totalTicks)
HeadlessSimulationRunner -> SimulationObserver : init(passengers)

loop tick = 1..1200
  HeadlessSimulationRunner -> DefaultFlightSimulationService : update(tick)

  loop for each passenger
    HeadlessSimulationRunner -> DefaultVitalSignsGenerator : generateNext(passenger, phase)
    DefaultVitalSignsGenerator --> HeadlessSimulationRunner : vitals
    HeadlessSimulationRunner -> Passenger : setVitalSigns(vitals)
  end

  loop for each passenger
    HeadlessSimulationRunner -> KnnHealthEvaluationService : evaluate(vitals, passenger, phase)
    KnnHealthEvaluationService --> HeadlessSimulationRunner : HealthEvaluationResult
    HeadlessSimulationRunner -> Passenger : setHealthStatus(overallStatus)
  end

  HeadlessSimulationRunner -> SimulationObserver : record(passengers, phase, tick)
end

HeadlessSimulationRunner -> SimulationObserver : printReport(emergencyNames)

@enduml
